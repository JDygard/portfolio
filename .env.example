# Copy to .env.local to test analytics locally. Leave unset for normal dev —
# the shim no-ops and logs events to the console instead.
#
# Production values live in GitHub repo *variables*
# (Settings -> Secrets and variables -> Actions -> Variables), not here.

# 'umami' | 'plausible' | '' (empty disables analytics entirely)
VITE_ANALYTICS_PROVIDER=umami

# --- Umami Cloud (free tier) ---
VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# Override only if self-hosting Umami:
# VITE_UMAMI_SRC=https://analytics.example.com/script.js

# --- Plausible (if VITE_ANALYTICS_PROVIDER=plausible) ---
# VITE_PLAUSIBLE_DOMAIN=jdygard.com
